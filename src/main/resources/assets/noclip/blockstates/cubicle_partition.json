{
  "multipart": [
    {
      "apply": {
        "model": "noclip:block/cubicle_partition_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "noclip:block/cubicle_partition_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "noclip:block/cubicle_partition_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "noclip:block/cubicle_partition_side_alt"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "noclip:block/cubicle_partition_side_alt",
        "y": 90
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "noclip:block/cubicle_partition_noside"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "noclip:block/cubicle_partition_noside_alt"
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "noclip:block/cubicle_partition_noside_alt",
        "y": 90
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "noclip:block/cubicle_partition_noside",
        "y": 270
      }
    }
  ]
}